{
  "name": "governance-lambda-functions",
  "version": "1.0.0",
  "description": "Lambda functions for Multi-Agent AI Governance System",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "middleware/**/*.js",
      "*/index.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/test/"
    ]
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.511.0",
    "@aws-sdk/client-dynamodb": "^3.511.0",
    "@aws-sdk/client-sns": "^3.511.0"
  }
}
