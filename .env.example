# ============================================================
# Multi-Agent AI Governance System - Environment Configuration
# ============================================================
# IMPORTANT: Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# Use AWS Secrets Manager or Parameter Store in production.
# ============================================================

# --- AWS Cognito Authentication ---
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_COGNITO_DOMAIN=your-domain.auth.us-east-1.amazoncognito.com

# --- API Configuration ---
VITE_API_BASE_URL=https://your-api-gateway-url.amazonaws.com/prod
VITE_WEBSOCKET_URL=wss://your-websocket-api.amazonaws.com/prod

# --- Agent Configuration ---
VITE_AGENT_UPDATE_INTERVAL=5000
VITE_ENABLE_REAL_TIME_UPDATES=true
VITE_MAX_CHAT_MESSAGE_LENGTH=2000
VITE_MAX_REQUESTS_PER_MINUTE=60

# --- Feature Flags ---
VITE_ENABLE_AUDIT_EXPORT=true
VITE_ENABLE_POLICY_APPROVALS=true
VITE_ENABLE_BIAS_DETECTION=true
VITE_ENABLE_MFA=true

# --- Environment ---
VITE_APP_ENV=development
# Options: development | staging | production

# ============================================================
# SERVER-SIDE ONLY (Lambda / Backend) - NOT for frontend use
# These must be set as Lambda environment variables or via
# AWS Secrets Manager - NEVER in frontend code.
# ============================================================

# AWS_REGION=us-east-1
# DYNAMODB_TABLE_AUDIT=governance-audit-logs
# DYNAMODB_TABLE_POLICIES=governance-policies
# DYNAMODB_TABLE_SESSIONS=governance-sessions
# S3_BUCKET_REPORTS=governance-compliance-reports
# KMS_KEY_ID=arn:aws:kms:us-east-1:123456789:key/xxxx
# JWT_SECRET=use-aws-secrets-manager-in-production
# ENCRYPTION_KEY=use-aws-kms-in-production
# ALLOWED_ORIGINS=https://your-frontend-domain.com
